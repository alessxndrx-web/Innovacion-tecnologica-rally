# Base de la API. Si no se define, se usa http://localhost:3000, que es donde
# escucha el backend en local y un origen que ya acepta su configuración CORS.
#
# Vite incrusta este valor en tiempo de compilación: al cambiarlo hay que
# reconstruir (`pnpm build`), no basta con reiniciar.
VITE_API_BASE_URL=http://localhost:3000
