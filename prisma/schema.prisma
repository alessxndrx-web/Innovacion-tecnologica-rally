generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  TEACHER
}

enum ActivityCategory {
  LETTERS
  NUMBERS
  COLORS
  SHAPES
  SEQUENCES
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  fullName     String
  role         UserRole
  avatarUrl    String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  learners     Learner[]
  attempts     ActivityAttempt[] @relation("AttemptStarter")
}

model Learner {
  id              String            @id @default(uuid())
  ownerId         String
  displayName     String
  avatarKey       String?
  birthYear       Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  learningProfile LearningProfile?
  attempts        ActivityAttempt[]

  @@index([ownerId])
}

model LearningProfile {
  id                String   @id @default(uuid())
  learnerId         String   @unique
  visualSupport     Boolean  @default(true)
  audioSupport      Boolean  @default(false)
  shortInstructions Boolean  @default(true)
  stepByStep        Boolean  @default(true)
  breaksEnabled     Boolean  @default(true)
  attentionSupport  Boolean  @default(true)
  autonomyLevel     Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  learner           Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model Activity {
  id               String            @id @default(uuid())
  title            String
  description      String
  category         ActivityCategory
  difficulty       Int               @default(1)
  estimatedMinutes Int
  imageUrl         String?
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  steps            ActivityStep[]
  attempts         ActivityAttempt[]

  @@index([isPublished, category, difficulty])
}

model ActivityStep {
  id               String            @id @default(uuid())
  activityId       String
  stepNumber       Int
  instruction      String
  imageUrl         String?
  audioUrl         String?
  expectedResponse Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activity         Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  responses        AttemptResponse[]

  @@unique([activityId, stepNumber])
  @@index([activityId])
}

model ActivityAttempt {
  id             String            @id @default(uuid())
  learnerId      String
  activityId     String
  startedById    String
  status         AttemptStatus     @default(IN_PROGRESS)
  currentStep    Int               @default(1)
  correctAnswers Int               @default(0)
  totalAnswers   Int               @default(0)
  score          Int               @default(0)
  stars          Int               @default(0)
  startedAt      DateTime          @default(now())
  completedAt    DateTime?
  updatedAt      DateTime          @updatedAt
  learner        Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  activity       Activity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  startedBy      User              @relation("AttemptStarter", fields: [startedById], references: [id], onDelete: Restrict)
  responses      AttemptResponse[]

  @@index([learnerId, startedAt])
  @@index([activityId])
  @@index([startedById])
}

model AttemptResponse {
  id             String          @id @default(uuid())
  attemptId      String
  activityStepId String
  response       Json
  isCorrect      Boolean?
  answeredAt     DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attempt        ActivityAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  activityStep   ActivityStep    @relation(fields: [activityStepId], references: [id], onDelete: Restrict)

  @@unique([attemptId, activityStepId])
  @@index([activityStepId])
}
