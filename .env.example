# Configuración local del MVP.
NODE_ENV=development
PORT=3000

# Prisma resuelve esta ruta desde prisma/schema.prisma.
DATABASE_URL=file:./dev.db

# Reemplace este valor por un secreto aleatorio de al menos 32 caracteres.
# Ejemplo: openssl rand -base64 48
# En producción el arranque falla si conserva el valor de ejemplo.
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=1h

# Lista de orígenes permitidos, separados por comas. No admite "*" en producción.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Póngalo en true solo si la API queda detrás de un balanceador o CDN que
# escriba X-Forwarded-For. Si no, la limitación por IP verá la del proxy y
# tratará a todos los clientes como uno solo.
TRUST_PROXY=false

# Límite general por IP y ventana.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Límite específico de /auth/register y /auth/login, mucho más estricto:
# cada llamada ejecuta argon2id con 19 MiB de memoria.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15m

# Documentación OpenAPI en /docs. Por defecto activa salvo en producción.
# ENABLE_DOCS=false
